# Deletion-receipt pepper rotation state, per service (#798).
#
# infra/cloudrun/flags.sh reads this file on every deploy and turns it into the
# pepper secret mapping and MAYBESITTER_DELETION_RECEIPT_PEPPER_WRITE. Change it
# only by following docs/operations/GCP_BOOTSTRAP.md, "Rotating the
# deletion-receipt pepper": one commit per phase per service, each deployed and
# verified before the next.
#
# Format: KEY=VALUE, one per line, no quotes, no spaces. Every key below must be
# present exactly once; flags.sh refuses anything else.
#
# <service>_phase
#   steady   no rotation. PEPPER = <service>_current_version; no PREVIOUS is
#            mounted; WRITE=current. <service>_previous_version must be empty.
#   readers  phase 1. PEPPER = <service>_current_version (the NEW key),
#            PREVIOUS = <service>_previous_version (the OLD key), WRITE=previous:
#            this revision reads both keys and still writes the old one.
#   writer   phase 2. The same two keys, WRITE=current: writes switch to the new
#            key. Only once no revision from before phase 1 serves traffic.
#
# <service>_current_version / <service>_previous_version
#   Secret Manager version numbers of maybesitter-deletion-receipt-pepper.
#   `latest` is accepted for current_version in `steady` only; a rotation needs
#   both versions pinned, so a new secret version can never be picked up by a
#   deploy (or an instance start) that does not know about the old one.
staging_phase=steady
staging_current_version=latest
staging_previous_version=
production_phase=steady
production_current_version=latest
production_previous_version=
