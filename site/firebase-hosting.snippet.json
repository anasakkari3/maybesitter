{
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/privacy", "destination": "/en/privacy", "type": 301 },
      { "source": "/terms", "destination": "/en/terms", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  }
}
