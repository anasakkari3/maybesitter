{
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.sh", "**/*.md", "en/**", "ar/**", "he/**", "firebase-hosting.snippet.json", "assets/product-today.png", "assets/product-calendar.png", "assets/product-first-move.png"],
    "rewrites": [
      { "source": "/api/early-access", "run": { "serviceId": "maybesitter-api", "region": "europe-west1" } },
      { "source": "/api/early-access/events", "run": { "serviceId": "maybesitter-api", "region": "europe-west1" } }
    ],
    "redirects": [
      { "source": "/privacy", "destination": "/early-access-privacy", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  }
}
