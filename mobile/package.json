{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/noto-sans-hebrew": "^0.4.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@formatjs/intl-getcanonicallocales": "3.2.11",
    "@formatjs/intl-locale": "5.3.10",
    "@formatjs/intl-pluralrules": "6.3.13",
    "@microsoft/react-native-clarity": "4.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-calendar": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.18",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.18",
    "expo-web-browser": "~57.0.3",
    "fflate": "0.8.3",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.14",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "check:no-credentials": "bash scripts/check-no-credentials.sh",
    "eas-build-on-success": "bash scripts/export-sourcemap.sh",
    "verify:release-android": "bash scripts/verify-release-android.sh",
    "check:privacy-manifests": "node scripts/check-privacy-manifests.mjs",
    "check:android-manifest": "bash scripts/check-android-manifest-merge.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|intl-messageformat|@formatjs))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^@expo-google-fonts/.*$": "<rootDir>/src/design/__mocks__/expoGoogleFonts.js"
    },
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "globalSetup": "<rootDir>/jest.globalSetup.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@bacons/xcode": {
      "@expo/plist": "^0.8.1",
      "uuid": "^11.1.1"
    }
  }
}
