# Copy to .env.local for local development. Never commit a filled-in copy.
# Only EXPO_PUBLIC_* values reach the app bundle, so none of them may be secret.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Development may point at a laptop. Staging and production must be a real
# https host: app.config.ts refuses to build otherwise (CFG-1).
# iOS simulator:      http://localhost:3000
# Android emulator:   http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Local-only backend bypass. Must stay empty; a staging or production build
# that sets it fails to configure (CFG-1).
EXPO_PUBLIC_DEV_BEARER_TOKEN=

# The published privacy policy and terms (OWNER-A1 #137). The sign-in screen
# renders the links only when these are set to an https URL, so an unpublished
# site shows no link rather than one that 404s. Do not invent a domain.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
