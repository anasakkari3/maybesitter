# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*

# Signing material and service accounts (UC-1.6a #150 step 4). None of this
# belongs in the repository: EAS holds the keystore and the Apple certificates,
# and the Play service-account key is uploaded to EAS rather than committed.
# `npm run check:no-credentials` fails the build if any of it is ever tracked.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest
credentials.json
*service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase app configuration is COMMITTED on purpose (UC-1.7 #151): these two
# files identify the project and authorise nothing, and a build cannot be made
# without them. The negations are explicit because many developers' global
# gitignore excludes both by name — the repository's policy has to win over a
# machine-level default, or the next clone builds against no Firebase project.
# The keys inside are restricted to com.maybesitter.app and to Identity
# Toolkit, Token Service and Firebase Installations.
!firebase/google-services.json
!firebase/GoogleService-Info.plist

# Per-build JS source maps for crash symbolication (UC-4.4, #180). Kept as a
# private EAS build artifact, never committed: a map from a different commit
# symbolicates to the wrong lines, which looks like an answer.
build/sourcemaps/

# Written into the widget's source folder by `@bacons/apple-targets` at every
# `expo prebuild` (UC-3.R1, #203): the extension's Info.plist and the colour
# assets generated from `targets/widget/expo-target.config.js`. Derived, like
# `/ios` itself — the config file is the source.
/targets/*/Info.plist
/targets/*/Assets.xcassets/
