{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "staging"
      },
      "buildArtifactPaths": [
        "build/sourcemaps/**/*"
      ]
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      },
      "buildArtifactPaths": [
        "build/sourcemaps/**/*"
      ]
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
