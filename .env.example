# Copy to .env.local for local development. Dummy values only — this file is
# committed. Each entry says where the real value is set.
#
# Tags on each entry:
#   [prod-required]  must be set on Cloud Run for the service to work
#   [optional]       read with a default; unset is safe
#   [dev]            local development, emulators, seeding or tooling only
#   [verification]   live provider checks; needs real credentials; never cloud
#   [secret]         a secret: Secret Manager in the cloud, never committed
#
# The Cloud Run boot check (lib/runtime/runtimeConfig.ts) refuses to start
# without GOOGLE_CLOUD_PROJECT and MAYBESITTER_STORAGE_BACKEND=firestore, and
# refuses MAYBESITTER_DEV_AUTH outright.

# --- Identity and storage ---------------------------------------------------
# [prod-required] local: your gcloud ADC project | cloud: Cloud Run env var
GOOGLE_CLOUD_PROJECT=maybesitter-app
# [optional] fallback project id when GOOGLE_CLOUD_PROJECT is unset (lib/firebase/admin.ts)
FIREBASE_PROJECT_ID=
# [optional] Vertex project for the hosted model; defaults to GOOGLE_CLOUD_PROJECT
MAYBESITTER_GCP_PROJECT=

# [prod-required] development | staging | production   (cloud: Cloud Run env var)
MAYBESITTER_ENV=development

# [prod-required] memory | firestore. Cloud Run must be firestore; the boot check refuses
# anything else there (UC-1.0e #144).
MAYBESITTER_STORAGE_BACKEND=memory

# [prod-required] Website tester sign-up (POST /api/early-access): the exact origins allowed to post,
# comma-separated, e.g. https://maybesitter-app.web.app. Unset on Cloud Run = every
# sign-up is refused (fails closed). Locally, same-origin requests are also accepted.
MAYBESITTER_SITE_ORIGINS=

# [optional] (default) in production, staging in the staging service (UC-1.0d #143).
MAYBESITTER_FIRESTORE_DATABASE_ID=(default)

# [dev] Local local file store root. Cloud Run keeps state in Firestore; this path is per-instance there.
MAYBESITTER_DATA_DIR=

# [dev] Local emulators only. Leave empty in the cloud; firebase-admin picks these
# up automatically when they are set.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# [dev] Web API key used by scripts/verify-durability.ts. The project web key is not a secret.
FIREBASE_WEB_API_KEY=

# --- Internal endpoints -----------------------------------------------------
# [prod-required] The service account Cloud Scheduler signs its OIDC tokens as, and the
# audience it targets. The jobs route accepts nothing else.
MAYBESITTER_SCHEDULER_SA_EMAIL=
MAYBESITTER_INTERNAL_AUDIENCE=
# [optional] Deployer service account used by infra scripts.
MAYBESITTER_DEPLOYER_SA_EMAIL=

# --- Google connections -----------------------------------------------------
# [prod-required] for Google Calendar and Gmail connections. OAuth client from Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
# [secret] cloud: Secret Manager. Never a plain env var in the cloud.
GOOGLE_OAUTH_CLIENT_SECRET=
# [prod-required] for Google connections; must match the redirect URI registered on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=
# [secret] Google Picker API key (calendar picker).
GOOGLE_PICKER_API_KEY=

# --- Encryption and secrets (never a plain env var in the cloud) ------------
# [prod-required] KMS key for field encryption. Without it, encrypted fields are refused rather than stored
# unencrypted (lib/security/fieldEncryption.ts).
MAYBESITTER_KMS_KEY_NAME=
# [secret] cloud: Secret Manager via --set-secrets. Local: leave empty unless testing
# deletion receipts.
MAYBESITTER_DELETION_RECEIPT_PEPPER=
# [secret] Only during a pepper rotation (#798; runbook in docs/operations/GCP_BOOTSTRAP.md).
# In the cloud flags.sh sets both from infra/cloudrun/pepper-rotation.env.
# PREVIOUS is the old key (a secret); WRITE picks which key names new deletion
# jobs: current (default) or previous.
MAYBESITTER_DELETION_RECEIPT_PEPPER_PREVIOUS=
MAYBESITTER_DELETION_RECEIPT_PEPPER_WRITE=
# [secret] Dedicated HMAC key for 15-minute postpone offers (at least 32 bytes).
MAYBESITTER_POSTPONE_SLOT_HMAC_KEY=
# [optional] Salt for LLM log pseudonyms (lib/llm/llmLog.ts). Set it where AI is on.
MAYBESITTER_LLM_UID_SALT=
# [secret] Bearer token for the pilot incident admin route. Unset = the route refuses.
MAYBESITTER_PILOT_ADMIN_TOKEN=
# [optional] Account ids that own pilot incidents and alpha traces (operations).
MAYBESITTER_PILOT_INCIDENT_OWNER_ID=
MAYBESITTER_ALPHA_TRACE_OWNER_ID=
# [optional] Backup destination for pilot data (lib/operations/pilotDataBackup.ts).
MAYBESITTER_PILOT_BACKUP_DIR=
MAYBESITTER_PILOT_BACKUP_PATH=

# --- Feature flags and kill switches ---------------------------------------
# Module flags are read from MAYBESITTER_FEATURE_<MODULE> and
# MAYBESITTER_KILL_SWITCH_<MODULE>, where <MODULE> is the module name in
# upper snake case (src/contracts/v1/runtimeControls.ts). Modules:
#   CAPTURE LIFE_STATE MEMORY PRIORITY DECOMPOSITION PLANNING RECOMMENDATION
#   COACHING FEEDBACK SAFETY EVALUATION GOAL_PLAN
# Empty means the default in code. "true" and "false" are the only accepted values.
MAYBESITTER_FEATURE_CAPTURE_KINDS=true
MAYBESITTER_KILL_SWITCH_CAPTURE_KINDS=false
MAYBESITTER_FEATURE_FREE_SLOTS=false
MAYBESITTER_KILL_SWITCH_FREE_SLOTS=false
MAYBESITTER_FEATURE_EXTERNAL_CLASH_HOLD=false
MAYBESITTER_KILL_SWITCH_EXTERNAL_CLASH_HOLD=false
MAYBESITTER_FEATURE_EVENING_IMPACT=false
MAYBESITTER_KILL_SWITCH_EVENING_IMPACT=false
MAYBESITTER_FEATURE_SMART_POSTPONE=false
MAYBESITTER_KILL_SWITCH_SMART_POSTPONE=false
MAYBESITTER_FEATURE_CALENDAR_CHOICE=false
MAYBESITTER_KILL_SWITCH_CALENDAR_CHOICE=false
MAYBESITTER_FEATURE_EMAIL_SOURCES=false
MAYBESITTER_KILL_SWITCH_EMAIL_SOURCES=false
MAYBESITTER_FEATURE_RECOMMENDATION=
MAYBESITTER_KILL_SWITCH_RECOMMENDATION=
MAYBESITTER_FEATURE_PROACTIVE_LOOP=
MAYBESITTER_KILL_SWITCH_PROACTIVE_LOOP=
MAYBESITTER_FEATURE_MEMORY_LEARNING=
MAYBESITTER_KILL_SWITCH_MEMORY_LEARNING=
MAYBESITTER_FEATURE_MEMORY_TRANSLATION=
MAYBESITTER_KILL_SWITCH_MEMORY_TRANSLATION=
MAYBESITTER_FEATURE_SEARCH_HISTORY=
MAYBESITTER_KILL_SWITCH_SEARCH_HISTORY=
MAYBESITTER_ALPHA_TRACE_ENABLED=
MAYBESITTER_ALPHA_FEEDBACK_ENABLED=
# [optional] Experiment arms for next-step ordering, and a pinned arm (lib/experiments/experimentControls.ts).
MAYBESITTER_EXPERIMENT_NEXT_STEP_ARMS=
MAYBESITTER_NEXT_STEP_ARM=
# [optional] Shadow release stage and cohort (lib/release/exposure.ts).
MAYBESITTER_SHADOW_STAGE=
MAYBESITTER_SHADOW_COHORT_IDS=

# --- Hosted model (UC-2.0, #160) -------------------------------------------
# Off unless this says otherwise, in every environment including production.
# #160's scope is explicit that capture text must not reach Vertex before
# UC-2.1 (#161)'s consent enforcement, so turning it on is a deployment
# decision someone makes rather than something a deploy does by itself.
#   gemini  - Vertex AI, Application Default Credentials, no API key
#   ollama  - local development only
#   none    - fall back to the rule-based extractor immediately (default)
MAYBESITTER_LLM_PROVIDER=
# Verified in europe-west1 on 2026-09-12: gemini-2.5-flash and
# gemini-2.5-flash-lite answer there; gemini-2.0-flash does not.
MAYBESITTER_LLM_MODEL=
# A region, never "global": capture text is processed where the consent screen
# says it is.
MAYBESITTER_VERTEX_LOCATION=
# [dev] Local model server, used with MAYBESITTER_LLM_PROVIDER=ollama.
MAYBESITTER_LLM_BASE_URL=
# [optional] Hard off-switch for every hosted-model call when set to true.
MAYBESITTER_AI_DISABLED=
# [optional] Cost guards (lib/llm/usageGuard.ts). Empty uses the code defaults.
MAYBESITTER_LLM_MINUTE_CALL_CAP=
MAYBESITTER_LLM_DAILY_CALL_CAP=
MAYBESITTER_LLM_GLOBAL_DAILY_CALL_CAP=
MAYBESITTER_LLM_DAILY_TOKEN_CAP=
MAYBESITTER_LLM_TIMEOUT_MS=
MAYBESITTER_LLM_MAX_RETRIES=
# [optional] Clauses sent per capture model call; the default is 3.
MAYBESITTER_CAPTURE_CLAUSES_PER_CALL=
# [optional] Model escalation for extraction (src/extraction/escalationConfig.ts).
MAYBESITTER_EXTRACTION_ESCALATION=

# --- Other providers ---------------------------------------------------------
# [optional] Football fixtures sync (lib/football). Without it the football sync does not run.
# [secret]
FOOTBALL_DATA_API_KEY=

# --- Build and observability -------------------------------------------------
# [optional] Commit SHA shown by GET /api/health. Set by the build.
MAYBESITTER_GIT_SHA=
# [optional] Public flag for the developer pages (Next.js build-time value).
NEXT_PUBLIC_MAYBESITTER_DEVELOPER_PAGES=

# --- Evaluation and live verification (never set in the cloud) ---------------
# [verification] The account id evaluation runs use.
MAYBESITTER_EVAL_UID=
# [verification] Each live check is off unless its flag is "true" and its credential is set.
MAYBESITTER_LIVE_PROVIDER_VERIFICATION=
MAYBESITTER_LIVE_CAPTURE_CHECK=
MAYBESITTER_LIVE_DOCUMENT_EVAL=
MAYBESITTER_LIVE_INJECTION_EVAL=
MAYBESITTER_LIVE_GOAL_STEPS=
MAYBESITTER_LIVE_GOAL_STEPS_MAX_CALLS=
MAYBESITTER_LIVE_MEETING_PREP=
MAYBESITTER_LIVE_MEETING_PREP_MAX_CALLS=
# [secret][verification] Short-lived provider access tokens for the live checks.
MAYBESITTER_LIVE_GOOGLE_ACCESS_TOKEN=
MAYBESITTER_LIVE_MEETING_ACCESS_TOKEN=
MAYBESITTER_LIVE_MICROSOFT_ACCESS_TOKEN=
# [secret][verification]
MAYBESITTER_LIVE_RESCUETIME_API_KEY=

# --- Local seeding (dev only) --------------------------------------------------
# [dev][secret] Password for the seed accounts created by the seed scripts.
SEED_ACCOUNT_PASSWORD=
# [dev] Base URL the seed scripts call.
SEED_API_BASE_URL=
