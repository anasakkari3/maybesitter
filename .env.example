# Copy to .env.local for local development. Dummy values only — this file is
# committed. Each entry says where the real value is set.

# --- Identity and storage ---------------------------------------------------
# local: your gcloud ADC project | cloud: Cloud Run env var
GOOGLE_CLOUD_PROJECT=maybesitter-app

# development | staging | production   (cloud: Cloud Run env var)
MAYBESITTER_ENV=development

# memory | firestore. Cloud Run must be firestore; the boot check refuses
# anything else there (UC-1.0e #144).
MAYBESITTER_STORAGE_BACKEND=memory

# (default) in production, staging in the staging service (UC-1.0d #143).
MAYBESITTER_FIRESTORE_DATABASE_ID=(default)

# Local emulators only. Leave empty in the cloud; firebase-admin picks these
# up automatically when they are set.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# --- Internal endpoints -----------------------------------------------------
# The service account Cloud Scheduler signs its OIDC tokens as, and the
# audience it targets. The jobs route accepts nothing else.
MAYBESITTER_SCHEDULER_SA_EMAIL=
MAYBESITTER_INTERNAL_AUDIENCE=

# --- Secrets (never a plain env var in the cloud) ---------------------------
# cloud: Secret Manager via --set-secrets. Local: leave empty unless testing
# deletion receipts.
MAYBESITTER_DELETION_RECEIPT_PEPPER=

# --- Feature flags and kill switches ---------------------------------------
# See src/contracts/v1/runtimeControls.ts for the full list and defaults.
MAYBESITTER_FEATURE_NEXT_STEP=
MAYBESITTER_KILL_SWITCH_RECOMMENDATIONS=
MAYBESITTER_ALPHA_TRACE_ENABLED=
MAYBESITTER_ALPHA_FEEDBACK_ENABLED=

# --- Hosted model (UC-2.0, #160) -------------------------------------------
# Off unless this says otherwise, in every environment including production.
# #160's scope is explicit that capture text must not reach Vertex before
# UC-2.1 (#161)'s consent enforcement, so turning it on is a deployment
# decision someone makes rather than something a deploy does by itself.
#   gemini  - Vertex AI, Application Default Credentials, no API key
#   ollama  - local development only
#   none    - fall back to the rule-based extractor immediately (default)
MAYBESITTER_LLM_PROVIDER=
# Verified in europe-west1 on 2026-09-12: gemini-2.5-flash and
# gemini-2.5-flash-lite answer there; gemini-2.0-flash does not.
MAYBESITTER_LLM_MODEL=
# A region, never "global": capture text is processed where the consent screen
# says it is.
MAYBESITTER_VERTEX_LOCATION=
MAYBESITTER_GCP_PROJECT=
MAYBESITTER_LLM_TIMEOUT_MS=
MAYBESITTER_LLM_MAX_RETRIES=
