rules_version = '2';

// Deny-all baseline (UC-1.0a, #140). Every write goes through the API, which
// authenticates the caller and validates the payload; the Admin SDK bypasses
// these rules. UC-1.0b (#141) replaces this with per-user read access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
